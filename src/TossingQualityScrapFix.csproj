<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <AssemblyName>TossingQualityScrapFix</AssemblyName>
    <RootNamespace>TossingQualityScrapFix</RootNamespace>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436;NU1701</NoWarn>
  </PropertyGroup>

  <!-- Machine-specific paths live in Local.props (git-ignored). Copy Local.props.example to Local.props. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\Local.props')" />

  <!-- Neither ZetArtifacts nor ItemQualities is referenced at compile time: both are reached by name through
       reflection, so a renamed member logs a warning and skips the fix instead of breaking the game. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RoR2"><HintPath>$(RoR2ManagedDir)\RoR2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RoR2ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RoR2ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(RoR2ManagedDir)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
