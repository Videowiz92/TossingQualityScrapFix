<Project>
  <PropertyGroup>
    <!-- "Risk of Rain 2_Data\Managed" inside your Steam install. -->
    <RoR2ManagedDir>C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</RoR2ManagedDir>
    <!-- "BepInEx\core" inside an r2modman / Thunderstore Mod Manager profile. -->
    <BepInExCoreDir>C:\Users\YOU\AppData\Roaming\r2modmanPlus-local\RiskOfRain2\profiles\Default\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>
</Project>
